{
  "name": "graphql-classifier",
  "version": "0.1.0",
  "description": "Scans GraphQL schemas and flags fields across pluggable analyses (PII, auth gaps, N+1 risk, naming/doc lint rules) using TypeSafe's Jev model.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cernst11/graphql-classifier.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "graphql-classifier": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graphql-tools/graphql-file-loader": "^8.0.0",
    "@graphql-tools/load": "^8.0.0",
    "@typesafe-ai/sdk": "^0.5.7",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "p-limit": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
